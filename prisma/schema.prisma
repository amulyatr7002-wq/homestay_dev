generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PropertyType {
  HOMESTAY
  COTTAGE
  CABIN
  FARM_STAY
  VILLA
  HERITAGE_HOME
}

enum Vibe {
  MOUNTAINS
  BEACH
  HERITAGE
  FARM
  FOREST
}

enum UserRole {
  GUEST
  HOST
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUND_PENDING
  REFUNDED
}

enum PaymentProvider {
  RAZORPAY
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  PAUSED
}

model User {
  id                 String         @id @default(cuid())
  name               String?
  email              String?        @unique
  emailVerified      DateTime?
  image              String?
  passwordHash       String?
  phone              String?        @unique
  role               UserRole       @default(GUEST)
  suspendedAt        DateTime?
  accounts           Account[]
  sessions           Session[]
  bookings           Booking[]
  reviews            Review[]
  wishlists          Wishlist[]
  hostProfile        HostProfile?
  listings           Listing[]      @relation("ListingHost")
  guestConversations Conversation[] @relation("ConversationGuest")
  hostConversations  Conversation[] @relation("ConversationHost")
  messages           Message[]
  auditLogs          AuditLog[]
  aiUsage            AiUsage[]
  aiFeedback         AiFeedback[]
  savedTrips          SavedTrip[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model HostProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  bio         String   @db.Text
  phone       String
  city        String
  photoUrl    String?
  languages   String[]
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Destination {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  region      String    @default("Karnataka")
  description String
  latitude    Float
  longitude   Float
  listings    Listing[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([region])
}

model Listing {
  id             String                @id @default(cuid())
  slug           String                @unique
  title          String
  description    String                @db.Text
  city           String
  address        String
  pricePerNight  Int
  rating         Float                 @default(0)
  reviewCount    Int                   @default(0)
  maxGuests      Int                   @default(2)
  propertyType   PropertyType
  vibe           Vibe
  latitude       Float
  longitude      Float
  hostName       String
  hostBio        String                @db.Text
  hostId         String?
  host           User?                 @relation("ListingHost", fields: [hostId], references: [id], onDelete: SetNull)
  status         ListingStatus         @default(PUBLISHED)
  rejectedReason String?               @db.Text
  draftData      Json?
  views          Int                   @default(0)
  bedrooms       Int                   @default(1)
  beds           Int                   @default(1)
  bathrooms      Int                   @default(1)
  cleaningFee    Int                   @default(0)
  weekendPrice   Int?
  houseRules     String                @default("") @db.Text
  checkInTime    String                @default("15:00")
  checkOutTime   String                @default("11:00")
  destinationId  String
  destination    Destination           @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  images         ListingImage[]
  amenities      Amenity[]
  bookings       Booking[]
  reviews        Review[]
  wishlists      Wishlist[]
  calendarDates  ListingCalendarDate[]
  conversations  Conversation[]
  featuredIn     FeaturedListing[]
  isFlagged      Boolean               @default(false)
  flagReason     String?               @db.Text
  vibeTags       String[]              @default([])
  reviewSummary Json?
  reviewSummaryReviewCount Int          @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([destinationId, pricePerNight])
  @@index([status, city, pricePerNight])
  @@index([propertyType, vibe, rating])
  @@index([latitude, longitude])
  @@index([hostId, status])
  @@index([status, createdAt])
}

model Booking {
  id              String        @id @default(cuid())
  reference       String        @unique
  userId          String
  listingId       String
  checkIn         DateTime      @db.Date
  checkOut        DateTime      @db.Date
  guests          Int
  nights          Int
  pricePerNight   Int
  nightlySubtotal Int           @default(0)
  cleaningFee     Int
  serviceFee      Int
  taxes           Int
  totalPrice      Int
  status          BookingStatus @default(PENDING)
  expiresAt       DateTime?
  confirmedAt     DateTime?
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  listing         Listing       @relation(fields: [listingId], references: [id], onDelete: Restrict)
  payments        Payment[]
  review          Review?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId, status, checkIn])
  @@index([listingId, status, checkIn, checkOut])
  @@index([status, checkIn, checkOut])
  @@index([status, expiresAt])
}

model Payment {
  id                String          @id @default(cuid())
  bookingId         String
  provider          PaymentProvider @default(RAZORPAY)
  orderId           String          @unique
  razorpayPaymentId String?         @unique
  signature         String?
  amountPaise       Int
  refundAmountPaise Int?
  currency          String          @default("INR")
  status            PaymentStatus   @default(CREATED)
  booking           Booking         @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([bookingId, status])
}

model Review {
  id            String    @id @default(cuid())
  bookingId     String    @unique
  userId        String
  listingId     String
  rating        Int
  comment       String    @db.Text
  hostReply     String?   @db.Text
  hostRepliedAt DateTime?
  isFlagged     Boolean   @default(false)
  flagReason    String?   @db.Text
  booking       Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  listing       Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([listingId, createdAt])
  @@index([userId])
}

model ListingCalendarDate {
  id            String   @id @default(cuid())
  listingId     String
  date          DateTime @db.Date
  isBlocked     Boolean  @default(false)
  pricePerNight Int?
  listing       Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([listingId, date])
  @@index([listingId, date])
}

model Conversation {
  id            String    @id @default(cuid())
  listingId     String
  guestId       String
  hostId        String
  listing       Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  guest         User      @relation("ConversationGuest", fields: [guestId], references: [id], onDelete: Cascade)
  host          User      @relation("ConversationHost", fields: [hostId], references: [id], onDelete: Cascade)
  messages      Message[]
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([listingId, guestId])
  @@index([hostId, lastMessageAt])
  @@index([guestId, lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String       @db.Text
  readAt         DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId, readAt])
}

model FeaturedCollection {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  description String            @db.Text
  imageUrl    String?
  isPublished Boolean           @default(false)
  listings    FeaturedListing[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model FeaturedListing {
  collectionId String
  listingId    String
  position     Int                @default(0)
  collection   FeaturedCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  listing      Listing            @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([collectionId, listingId])
  @@index([collectionId, position])
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  entityType String
  entityId   String
  details    Json?
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([listingId])
}

model ApiRateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

model AiUsage {
  id        String   @id @default(cuid())
  userId    String?
  feature   String
  tokens    Int      @default(0)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([feature, createdAt])
}

model AiFeedback {
  id        String   @id @default(cuid())
  userId    String?
  feature   String
  helpful   Boolean
  turnId    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([feature, createdAt])
  @@index([userId, createdAt])
}

model SavedTrip {
  id        String   @id @default(cuid())
  userId    String
  title     String
  itinerary Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model ListingImage {
  id        String   @id @default(cuid())
  url       String
  publicId  String?
  alt       String
  position  Int      @default(0)
  isCover   Boolean  @default(false)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([listingId, position])
}

model Amenity {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  listings Listing[]
}
